{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try { require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT || process.env.PLUGIN_ROOT || process.argv[1], 'hooks/session-start.cjs')); } catch {}\" \"${extensionPath}\""
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try { require(require('path').join(process.env.CLAUDE_PLUGIN_ROOT || process.env.PLUGIN_ROOT || process.argv[1], 'hooks/session-start.cjs')); } catch {}\" \"${extensionPath}\""
          }
        ]
      }
    ]
  }
}
